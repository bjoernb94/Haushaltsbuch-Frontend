{
  "name": "haushaltsbuch-frontend",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "test:ci": "ng test --watch=false",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:typen": "openapi-typescript ../Haushaltsbuch-Backend/docs/openapi.json -o src/app/core/api/api.generated.ts",
    "outdated": "ng update",
    "audit": "npm audit",
    "image": "podman build --build-arg VERSION=$npm_package_version --build-arg COMMIT=$(git rev-parse --short HEAD 2>/dev/null) --build-arg BUILD_ZEIT=$(date -u +%Y-%m-%dT%H:%M:%SZ) -t haushaltsbuch-frontend:latest -f Containerfile .",
    "image:pruefen": "e2e-image/pruefen.sh"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@fontsource-variable/manrope": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
