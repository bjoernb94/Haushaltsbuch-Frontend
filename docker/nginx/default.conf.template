# Wird beim Containerstart per envsubst zu /etc/nginx/conf.d/default.conf (BACKEND_URL).
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Backend erst pro Request auflösen, damit nginx auch ohne laufendes Backend startet.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend ${BACKEND_URL};

    # Nur die API, der Systemstatus sowie Version und Umgebung; die Sicherheits-Header dieser Antworten setzt
    # das Backend.
    location ~ ^/(api(/|$)|actuator/(health/systemstatus|info)$) {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    # Nur gehashte Bundles dürfen lange gecacht werden; index.html und public/ haben keinen Hash.
    location ~ "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$" {
        include /etc/nginx/snippets/sicherheits-header.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/sicherheits-header.conf;
        add_header Cache-Control "no-cache";
    }
}
