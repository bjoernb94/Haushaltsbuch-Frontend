# Wird beim Containerstart per envsubst zu /etc/nginx/conf.d/default.conf (BACKEND_URL).
server {
    listen 80;
    root /usr/share/nginx/html;

    # Backend erst pro Request auflösen, damit nginx auch ohne laufendes Backend startet.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend ${BACKEND_URL};

    location ~ ^/(api|oauth2|login|logout|actuator)(/|$) {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    # Gehashte Bundles dürfen lange gecacht werden, index.html nie.
    location ~* \.(js|css|woff2?|ico|png|svg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
